{
  "functions": {
    "api/rootedos.js": {
      "maxDuration": 60
    },
    "api/contact.js": {
      "maxDuration": 15
    },
    "api/share-page.js": {
      "maxDuration": 10
    },
    "api/share-image.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/share/:slug",
      "destination": "/api/share-page?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
